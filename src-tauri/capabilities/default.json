{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Clipboard Cleaner runtime capability for tray + clipboard access.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:menu:default",
    "core:tray:default",
    "core:image:default",
    "core:resources:default",
    "core:app:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "fs:allow-mkdir",
    "fs:allow-read",
    "fs:allow-read-text-file",
    "fs:allow-write",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "clipboard-cleaner",
        "clipboard-cleaner/*",
        "clipboard-cleaner/**/*",
        "$APPCONFIG/clipboard-cleaner",
        "$APPCONFIG/clipboard-cleaner/*",
        "$APPCONFIG/clipboard-cleaner/**/*"
      ]
    }
  ]
}
